 fixture();fail_phy=1;assert(mtk_dsi_poweron(&dsi)==0 && dsi.refcount==1 && phy_on==1 && engine_on==1 && digital_on==1 && configured);
 fixture();fail_phy=1;assert(donor_poweron(&dsi)==0 && configured && cmd_mode==1);
 fixture();fail_rate=1;assert(mtk_dsi_poweron(&dsi)==-EIO && !dsi.refcount && !phy_on);
 fixture();fail_engine=1;assert(mtk_dsi_poweron(&dsi)==-EIO && !dsi.refcount && phy_off==1 && !configured);
 fixture();fail_digital=1;fail_off=1;assert(mtk_dsi_poweron(&dsi)==-EIO && !dsi.refcount && engine_off==1 && phy_off==1 && !configured);
 fixture();assert(mtk_dsi_poweron(&dsi)==0 && dsi.refcount==1 && configured && !cmd_mode);
 fixture();fail_reset=1;assert(mtk_dsi_bind(&pdev.dev,NULL,NULL)==-EIO && encoder_created==1 && !encoder_cleaned);mtk_dsi_unbind(&pdev.dev,NULL,NULL);assert(encoder_cleaned==1);
 fixture();struct mipi_dsi_device device={.lanes=0,.format=0,.mode_flags=0};assert(mtk_dsi_host_attach(&dsi.host,&device)==0 && dsi.lanes==0 && component_add_calls==1);assert(mtk_dsi_host_detach(&dsi.host,&device)==0 && component_del_calls==1 && bridge_remove==1);
 fixture();device.lanes=5;fail_component=1;assert(mtk_dsi_host_attach(&dsi.host,&device)==-EIO && dsi.lanes==5 && bridge_add==1 && bridge_remove==1);
 fixture();fail_bridge1=-EPROBE_DEFER;assert(mtk_dsi_host_attach(&dsi.host,&device)==-EPROBE_DEFER && bridge_get==1 && !component_add_calls);
 fixture();fail_bridge1=-ENODEV;fail_bridge2=-ENOENT;assert(mtk_dsi_host_attach(&dsi.host,&device)==-ENOENT && bridge_get==2 && !component_add_calls);
 for(int i=1;i<=9;i++){fixture();fail_probe=i;int ret=mtk_dsi_probe(&pdev);assert(ret==(i==1?-ENOMEM:-EIO));assert(host_unreg==(i==9?1U:0U));assert(!component_add_calls && !bridge_get);}
 fixture();assert(mtk_dsi_probe(&pdev)==0 && host_reg==1 && irq_request==1 && !component_add_calls && !reset_calls);
 unsigned lengths[]={1,2,3,508,509,1020};static unsigned char payload[1020];memset(payload,0x5a,sizeof(payload));
 for(unsigned i=0;i<sizeof(lengths)/sizeof(*lengths);i++)for(unsigned lp=0;lp<2;lp++){
  fixture();struct mipi_dsi_msg msg={.type=MIPI_DSI_DCS_LONG_WRITE,.flags=lp?MIPI_DSI_MSG_USE_LPM:0,.tx_len=lengths[i],.tx_buf=payload};ack_cmdq(&dsi,&msg);u32 ack=regs[0x200/4];
  if(lengths[i]==508)assert(max_offset<0x400);
