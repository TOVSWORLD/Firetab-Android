{
  "root": "http://devicetree.org/schemas/phy/mediatek,tphy.yaml",
  "schemas": {
    "http://devicetree.org/schemas/phy/mediatek,tphy.yaml": {
      "$id": "http://devicetree.org/schemas/phy/mediatek,tphy.yaml#",
      "$schema": "http://devicetree.org/meta-schemas/core.yaml#",
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "reg": {
                "maxItems": 1
              },
              "reg-names": false
            }
          },
          "if": {
            "properties": {
              "compatible": {
                "contains": {
                  "const": "mediatek,mt8163-tphy"
                }
              }
            }
          },
          "then": {
            "patternProperties": {
              "^(usb|pcie|sata)-phy@[0-9a-f]+$": {
                "properties": {
                  "mediatek,eye-src": false
                }
              }
            },
            "properties": {
              "mediatek,src-coef": false,
              "mediatek,src-ref-clk-mhz": false,
              "reg": {
                "maxItems": 2,
                "minItems": 2
              }
            },
            "required": [
              "reg",
              "reg-names"
            ]
          }
        }
      ],
      "patternProperties": {
        "^(usb|pcie|sata)-phy@[0-9a-f]+$": {
          "additionalProperties": false,
          "patternProperties": {
            "^pinctrl-[0-9]+$": true
          },
          "properties": {
            "#phy-cells": {
              "const": 1
            },
            "$nodename": true,
            "assigned-clock-parents": true,
            "assigned-clock-rates": true,
            "assigned-clock-rates-u64": true,
            "assigned-clock-sscs": true,
            "assigned-clocks": true,
            "bootph-all": true,
            "bootph-pre-ram": true,
            "bootph-pre-sram": true,
            "bootph-some-ram": true,
            "bootph-verify": true,
            "clock-names": {
              "items": [
                {
                  "const": "ref"
                },
                {
                  "const": "da_ref"
                }
              ],
              "maxItems": 2,
              "minItems": 1,
              "type": "array"
            },
            "clocks": {
              "maxItems": 2,
              "minItems": 1,
              "type": "array"
            },
            "mediatek,bc12": {
              "type": "boolean"
            },
            "mediatek,discth": {
              "$ref": "/schemas/types.yaml#/definitions/uint32",
              "maximum": 15,
              "minimum": 1
            },
            "mediatek,eye-src": {
              "$ref": "/schemas/types.yaml#/definitions/uint32",
              "maximum": 7,
              "minimum": 1
            },
            "mediatek,eye-term": {
              "$ref": "/schemas/types.yaml#/definitions/uint32",
              "maximum": 7,
              "minimum": 1
            },
            "mediatek,eye-vrt": {
              "$ref": "/schemas/types.yaml#/definitions/uint32",
              "maximum": 7,
              "minimum": 1
            },
            "mediatek,force-mode": {
              "type": "boolean"
            },
            "mediatek,intr": {
              "$ref": "/schemas/types.yaml#/definitions/uint32",
              "maximum": 31,
              "minimum": 1
            },
            "mediatek,pre-emphasis": {
              "$ref": "/schemas/types.yaml#/definitions/uint32",
              "maximum": 3,
              "minimum": 1
            },
            "mediatek,syscon-type": {
              "$ref": "/schemas/types.yaml#/definitions/phandle-array",
              "items": {
                "items": [
                  {},
                  {},
                  {
                    "enum": [
                      0,
                      1,
                      2,
                      3
                    ]
                  }
                ],
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "maxItems": 1,
              "type": "array"
            },
            "nvmem-cell-names": {
              "items": [
                {
                  "const": "intr"
                },
                {
                  "const": "rx_imp"
                },
                {
                  "const": "tx_imp"
                }
              ],
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "nvmem-cells": {
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "phandle": true,
            "pinctrl-names": true,
            "reg": {
              "maxItems": 1,
              "minItems": 1
            },
            "secure-status": true,
            "status": true
          },
          "required": [
            "reg",
            "#phy-cells"
          ],
          "type": "object"
        },
        "^pinctrl-[0-9]+$": true
      },
      "properties": {
        "#address-cells": {
          "enum": [
            1,
            2
          ]
        },
        "#size-cells": {
          "enum": [
            1,
            2
          ]
        },
        "$nodename": {
          "items": [
            {
              "pattern": "^t-phy(@[0-9a-f]+)?$"
            }
          ],
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "bootph-all": true,
        "bootph-pre-ram": true,
        "bootph-pre-sram": true,
        "bootph-some-ram": true,
        "bootph-verify": true,
        "compatible": {
          "oneOf": [
            {
              "items": [
                {
                  "enum": [
                    "mediatek,mt2701-tphy",
                    "mediatek,mt8163-tphy",
                    "mediatek,mt7623-tphy",
                    "mediatek,mt7622-tphy",
                    "mediatek,mt8516-tphy"
                  ]
                },
                {
                  "const": "mediatek,generic-tphy-v1"
                }
              ],
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "items": [
                {
                  "enum": [
                    "mediatek,mt2712-tphy",
                    "mediatek,mt6893-tphy",
                    "mediatek,mt7629-tphy",
                    "mediatek,mt7986-tphy",
                    "mediatek,mt8183-tphy",
                    "mediatek,mt8186-tphy",
                    "mediatek,mt8192-tphy",
                    "mediatek,mt8365-tphy"
                  ]
                },
                {
                  "const": "mediatek,generic-tphy-v2"
                }
              ],
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "items": [
                {
                  "enum": [
                    "mediatek,mt8188-tphy",
                    "mediatek,mt8195-tphy"
                  ]
                },
                {
                  "const": "mediatek,generic-tphy-v3"
                }
              ],
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "deprecated": true,
              "items": [
                {
                  "const": "mediatek,mt2701-u3phy"
                }
              ],
              "maxItems": 1,
              "minItems": 1,
              "type": "array"
            },
            {
              "deprecated": true,
              "items": [
                {
                  "const": "mediatek,mt2712-u3phy"
                }
              ],
              "maxItems": 1,
              "minItems": 1,
              "type": "array"
            },
            {
              "items": [
                {
                  "const": "mediatek,mt8173-u3phy"
                }
              ],
              "maxItems": 1,
              "minItems": 1,
              "type": "array"
            }
          ]
        },
        "dma-ranges": true,
        "mediatek,src-coef": {
          "$ref": "/schemas/types.yaml#/definitions/uint32",
          "default": 28
        },
        "mediatek,src-ref-clk-mhz": {
          "default": 26
        },
        "phandle": true,
        "pinctrl-names": true,
        "power-domains": {
          "maxItems": 1,
          "minItems": 1
        },
        "ranges": true,
        "reg": {
          "maxItems": 2,
          "minItems": 1
        },
        "reg-names": {
          "items": [
            {
              "const": "sif"
            },
            {
              "const": "u2-frequency"
            }
          ],
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "secure-status": true,
        "status": true
      },
      "required": [
        "compatible",
        "#address-cells",
        "#size-cells",
        "ranges"
      ],
      "title": "MediaTek T-PHY Controller",
      "type": "object"
    },
    "http://devicetree.org/schemas/types.yaml": {
      "$id": "http://devicetree.org/schemas/types.yaml#",
      "$schema": "http://devicetree.org/meta-schemas/base.yaml#",
      "definitions": {
        "address": {
          "$ref": "#/definitions/uint32-matrix",
          "items": {
            "maxItems": 5,
            "minItems": 1
          },
          "type": "array"
        },
        "flag": {
          "oneOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "int16": {
          "maximum": 8191,
          "minimum": -8192,
          "type": "integer",
          "typeSize": 16
        },
        "int16-array": {
          "items": {
            "$ref": "#/definitions/int16"
          },
          "minItems": 1,
          "type": "array"
        },
        "int16-matrix": {
          "items": {
            "$ref": "#/definitions/int16-array"
          },
          "minItems": 1,
          "type": "array"
        },
        "int32": {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        "int32-array": {
          "items": {
            "$ref": "#/definitions/int32"
          },
          "minItems": 1,
          "type": "array"
        },
        "int32-matrix": {
          "items": {
            "$ref": "#/definitions/int32-array"
          },
          "minItems": 1,
          "type": "array"
        },
        "int64": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer",
          "typeSize": 64
        },
        "int64-array": {
          "items": {
            "$ref": "#/definitions/int64"
          },
          "minItems": 1,
          "type": "array"
        },
        "int64-matrix": {
          "items": {
            "$ref": "#/definitions/int64-array"
          },
          "minItems": 1,
          "type": "array"
        },
        "int8": {
          "maximum": 127,
          "minimum": -128,
          "type": "integer",
          "typeSize": 8
        },
        "int8-array": {
          "items": {
            "$ref": "#/definitions/int8"
          },
          "minItems": 1,
          "type": "array"
        },
        "int8-matrix": {
          "items": {
            "$ref": "#/definitions/int8-array"
          },
          "minItems": 1,
          "type": "array"
        },
        "non-unique-string-array": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "phandle": {
          "$ref": "#/definitions/phandle-array",
          "items": {
            "maxItems": 1,
            "minItems": 1
          },
          "maxItems": 1,
          "type": "array"
        },
        "phandle-array": {
          "items": {
            "additionalItems": {
              "$ref": "#/definitions/uint32"
            },
            "items": [
              {
                "oneOf": [
                  {
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "const": 0,
                    "type": "integer"
                  }
                ]
              }
            ],
            "maxItems": 1024,
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "type": "array"
        },
        "string": {
          "allOf": [
            {
              "$ref": "#/definitions/string-array"
            },
            {
              "maxItems": 1,
              "minItems": 1
            }
          ]
        },
        "string-array": {
          "allOf": [
            {
              "$ref": "#/definitions/non-unique-string-array"
            },
            {
              "uniqueItems": true
            }
          ]
        },
        "uint16": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer",
          "typeSize": 16
        },
        "uint16-array": {
          "items": {
            "$ref": "#/definitions/uint16"
          },
          "minItems": 1,
          "type": "array"
        },
        "uint16-matrix": {
          "items": {
            "$ref": "#/definitions/uint16-array"
          },
          "minItems": 1,
          "type": "array"
        },
        "uint32": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer",
          "typeSize": 32
        },
        "uint32-array": {
          "items": {
            "$ref": "#/definitions/uint32"
          },
          "minItems": 1,
          "type": "array"
        },
        "uint32-matrix": {
          "items": {
            "$ref": "#/definitions/uint32-array"
          },
          "minItems": 1,
          "type": "array"
        },
        "uint64": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer",
          "typeSize": 64
        },
        "uint64-array": {
          "items": {
            "$ref": "#/definitions/uint64"
          },
          "minItems": 1,
