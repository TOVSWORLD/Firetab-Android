      "allOf": [
        {
          "$ref": "#/$defs/capabilities"
        },
        {
          "if": {
            "properties": {
              "compatible": {
                "contains": {
                  "const": "gpio-usb-b-connector"
                }
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "vbus-gpios"
                ]
              },
              {
                "required": [
                  "id-gpios"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "compatible": {
                "contains": {
                  "const": "samsung,usb-connector-11pin"
                }
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "items": [
                  {
                    "const": "micro"
                  }
                ],
                "maxItems": 1,
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ],
      "anyOf": [
