          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "interrupt-parent": true,
        "interrupts": {
          "maxItems": 1,
          "minItems": 1
        },
        "interrupts-extended": {
          "maxItems": 1,
          "minItems": 1
