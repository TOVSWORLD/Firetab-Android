        "phandle": true,
        "phys": {
          "maxItems": 1,
          "minItems": 1
        },
        "pinctrl-names": true,
        "power-domains": {
          "maxItems": 1,
          "minItems": 1
        },
        "reg": {
          "maxItems": 1,
          "minItems": 1
        },
        "secure-status": true,
        "status": true,
        "usb-role-switch": {
          "$ref": "/schemas/types.yaml#/definitions/flag",
          "type": "boolean"
        }
      },
      "required": [
        "compatible",
        "reg",
        "interrupt-names",
