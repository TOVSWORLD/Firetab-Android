{
  "root": "http://devicetree.org/schemas/pinctrl/mediatek,mt65xx-pinctrl.yaml",
  "schemas": {
    "http://devicetree.org/schemas/pinctrl/mediatek,mt65xx-pinctrl.yaml": {
      "$filename": "<ack-bindings>/pinctrl/mediatek,mt65xx-pinctrl.yaml",
      "$id": "http://devicetree.org/schemas/pinctrl/mediatek,mt65xx-pinctrl.yaml#",
      "$schema": "http://devicetree.org/meta-schemas/core.yaml#",
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "pinctrl.yaml#"
        },
        {
          "if": {
            "properties": {
              "compatible": {
                "items": [
                  {
                    "const": "mediatek,mt8163-pinctrl"
                  }
                ],
                "maxItems": 1,
                "minItems": 1,
                "type": "array"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "interrupts"
                ]
              },
              {
                "required": [
                  "interrupts-extended"
                ]
              }
            ],
            "required": [
              "reg",
              "mediatek,pctl-regmap",
              "interrupt-controller",
              "#interrupt-cells"
            ]
          }
        }
      ],
      "patternProperties": {
        "^pinctrl-[0-9]+$": true,
        "pins$": {
          "additionalProperties": false,
          "patternProperties": {
            "(^pins|pins?$)": {
              "$ref": "/schemas/pinctrl/pincfg-node.yaml",
              "additionalProperties": false,
              "patternProperties": {
                "^pinctrl-[0-9]+$": true
              },
              "properties": {
                "$nodename": true,
                "bias-disable": true,
                "bias-pull-down": true,
                "bias-pull-up": {},
                "bootph-all": true,
                "bootph-pre-ram": true,
                "bootph-pre-sram": true,
                "bootph-some-ram": true,
                "bootph-verify": true,
                "drive-strength": {},
                "input-disable": true,
                "input-enable": true,
                "input-schmitt-disable": true,
                "input-schmitt-enable": true,
                "output-high": true,
                "output-low": true,
                "phandle": true,
                "pinctrl-names": true,
                "pinmux": {},
                "secure-status": true,
                "status": true
              },
              "required": [
                "pinmux"
              ],
              "type": "object"
            },
            "^pinctrl-[0-9]+$": true
          },
          "properties": {
            "$nodename": true,
            "bootph-all": true,
            "bootph-pre-ram": true,
            "bootph-pre-sram": true,
            "bootph-some-ram": true,
            "bootph-verify": true,
            "phandle": true,
            "pinctrl-names": true,
            "secure-status": true,
            "status": true
          },
          "type": "object"
        }
      },
      "properties": {
        "#gpio-cells": {
          "const": 2
        },
        "#interrupt-cells": {
          "const": 2
        },
        "$nodename": true,
        "bootph-all": true,
        "bootph-pre-ram": true,
        "bootph-pre-sram": true,
        "bootph-some-ram": true,
        "bootph-verify": true,
        "compatible": {
          "items": [
            {
              "enum": [
                "mediatek,mt2701-pinctrl",
                "mediatek,mt2712-pinctrl",
                "mediatek,mt6397-pinctrl",
                "mediatek,mt7623-pinctrl",
                "mediatek,mt8127-pinctrl",
                "mediatek,mt8135-pinctrl",
                "mediatek,mt8163-pinctrl",
                "mediatek,mt8167-pinctrl",
                "mediatek,mt8173-pinctrl",
                "mediatek,mt8516-pinctrl"
              ]
            }
          ],
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "gpio-controller": true,
        "gpio-line-names": true,
        "interrupt-controller": true,
        "interrupt-parent": true,
        "interrupts": {
          "maxItems": 3,
          "minItems": 1
        },
        "interrupts-extended": {
          "maxItems": 3,
          "minItems": 1
        },
        "mediatek,pctl-regmap": {
          "$ref": "/schemas/types.yaml#/definitions/phandle-array",
          "items": {
            "maxItems": 1,
            "minItems": 1
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array"
        },
        "phandle": true,
        "pinctrl-names": true,
        "pins-are-numbered": {
          "$ref": "/schemas/types.yaml#/definitions/flag",
          "deprecated": true
        },
        "reg": {
          "maxItems": 1,
          "minItems": 1
        },
        "secure-status": true,
        "status": true
      },
      "required": [
        "compatible",
        "gpio-controller",
        "#gpio-cells"
      ],
      "title": "MediaTek MT65xx Pin Controller",
      "type": "object"
    },
    "http://devicetree.org/schemas/pinctrl/pincfg-node.yaml": {
      "$filename": "<ack-bindings>/pinctrl/pincfg-node.yaml",
      "$id": "http://devicetree.org/schemas/pinctrl/pincfg-node.yaml#",
      "$schema": "http://devicetree.org/meta-schemas/core.yaml#",
      "properties": {
        "bias-bus-hold": {
          "type": "boolean"
        },
        "bias-disable": {
          "type": "boolean"
        },
        "bias-high-impedance": {
          "type": "boolean"
        },
        "bias-pull-down": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "/schemas/types.yaml#/definitions/uint32"
            }
          ]
        },
        "bias-pull-pin-default": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "/schemas/types.yaml#/definitions/uint32"
            }
          ]
        },
        "bias-pull-up": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "/schemas/types.yaml#/definitions/uint32"
            }
          ]
        },
        "drive-open-drain": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "/schemas/types.yaml#/definitions/uint32",
              "const": 1,
              "deprecated": true
            }
          ]
        },
        "drive-open-source": {
          "type": "boolean"
        },
        "drive-push-pull": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "/schemas/types.yaml#/definitions/uint32",
              "deprecated": true,
              "enum": [
                0,
                1
              ]
            }
          ]
        },
        "drive-strength": {
          "$ref": "/schemas/types.yaml#/definitions/uint32"
        },
        "drive-strength-microamp": {},
        "input-debounce": {
          "$ref": "/schemas/types.yaml#/definitions/uint32-array"
        },
        "input-disable": {
          "type": "boolean"
        },
        "input-enable": {
          "type": "boolean"
        },
        "input-schmitt-disable": {
          "type": "boolean"
        },
        "input-schmitt-enable": {
          "type": "boolean"
        },
        "input-schmitt-microvolt": {},
        "low-power-disable": {
          "type": "boolean"
        },
        "low-power-enable": {
          "type": "boolean"
        },
        "output-disable": {
          "type": "boolean"
        },
        "output-enable": {
          "type": "boolean"
        },
        "output-high": {
          "type": "boolean"
        },
        "output-impedance-ohms": {},
        "output-low": {
          "type": "boolean"
        },
        "power-source": {
          "$ref": "/schemas/types.yaml#/definitions/uint32"
        },
        "skew-delay": {
          "$ref": "/schemas/types.yaml#/definitions/uint32"
        },
        "sleep-hardware-state": {
          "type": "boolean"
        },
        "slew-rate": {
          "$ref": "/schemas/types.yaml#/definitions/uint32"
        }
      },
      "title": "Generic Pin Configuration Node",
      "type": "object"
    },
    "http://devicetree.org/schemas/pinctrl/pinctrl.yaml": {
      "$filename": "<ack-bindings>/pinctrl/pinctrl.yaml",
      "$id": "http://devicetree.org/schemas/pinctrl/pinctrl.yaml#",
      "$schema": "http://devicetree.org/meta-schemas/core.yaml#",
      "properties": {
        "#pinctrl-cells": {},
        "$nodename": {
          "items": [
            {
              "pattern": "^(pinctrl|pinmux)(@[0-9a-f]+)?$"
            }
          ],
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "pinctrl-use-default": {
          "type": "boolean"
        }
      },
      "select": {
        "properties": {
          "$nodename": {
            "items": [
              {
                "pattern": "^(pinctrl|pinmux)(@[0-9a-f]+)?$"
              }
            ],
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "$nodename"
        ]
      },
      "title": "Pin controller device",
      "type": "object"
    },
    "http://devicetree.org/schemas/types.yaml": {
      "$filename": "<ack-bindings>/types.yaml",
      "$id": "http://devicetree.org/schemas/types.yaml#",
      "$schema": "http://devicetree.org/meta-schemas/base.yaml#",
      "definitions": {
        "address": {
          "$ref": "#/definitions/uint32-matrix",
          "items": {
            "maxItems": 5,
            "minItems": 1
          },
          "type": "array"
        },
        "flag": {
          "oneOf": [
            {
              "const": true,
