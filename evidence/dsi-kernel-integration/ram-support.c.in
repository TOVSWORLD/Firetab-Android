#define READ_ONCE(x) (x)
#define check_mul_overflow(a,b,p) __builtin_mul_overflow(a,b,p)
#define check_add_overflow(a,b,p) __builtin_add_overflow(a,b,p)
#define min_t(t,a,b) ((t)(a)<(t)(b)?(t)(a):(t)(b))
#define div_u64(n,d) ((n)/(d))
#define IRQ_NONE 0
#define IRQ_HANDLED 1
#define IORESOURCE_MEM 0
#define msecs_to_jiffies(x) (x)
static int poll_error;static long wait_result=1;static unsigned irq_enabled,irq_disabled;
#define readl_poll_timeout(p,v,c,d,t) ((v)=readl(p),(c)?poll_error:-ETIMEDOUT)
#define wait_event_interruptible_timeout(q,c,t) (wait_result)
static void mutex_init(struct mutex *m){m->held=0;}
static void mutex_lock(struct mutex *m){assert(!m->held);m->held=1;}
static void mutex_unlock(struct mutex *m){assert(m->held);m->held=0;}
#define spin_lock_init(p) (*(p)=0)
#define spin_lock_irqsave(p,f) ((f)=0,assert(!*(p)),(*(p)=1))
#define spin_unlock_irqrestore(p,f) ((void)(f),assert(*(p)),(*(p)=0))
static void enable_irq(int i){assert(i==195);irq_enabled++;}
static void disable_irq(int i){assert(i==195);irq_disabled++;}
static void wake_up_interruptible(int *q){(void)q;}
static u8 readb(void *p){return ((u8 *)regs)[(uintptr_t)p-(uintptr_t)regs];}
static void mtk_dsi_stop(struct mtk_dsi *d){assert(d==&dsi);configured++;}
static void mtk_dsi_start(struct mtk_dsi *d){assert(d==&dsi);configured++;}
static void mtk_dsi_disable(struct mtk_dsi *d){assert(d==&dsi);configured++;}
static void mtk_dsi_lane0_ulp_mode_enter(struct mtk_dsi *d){assert(d==&dsi);configured++;}
static void mtk_dsi_clk_ulp_mode_enter(struct mtk_dsi *d){assert(d==&dsi);configured++;}
static void mtk_dsi_lane_ready(struct mtk_dsi *d){assert(d==&dsi);configured++;}
static void mtk_dsi_set_mode(struct mtk_dsi *d){assert(d==&dsi);configured++;}
static int device_reset(struct device *d){return device_reset_optional(d);}
static bool mipi_dsi_packet_format_is_short(u8 t){return t==MIPI_DSI_DCS_SHORT_WRITE||t==MIPI_DSI_DCS_READ;}
static bool mipi_dsi_packet_format_is_long(u8 t){return t==MIPI_DSI_DCS_LONG_WRITE;}
struct resource {uint64_t start,end;};static struct resource resource={0x14012000,0x14012fff};static bool resource_present=true,property_present=true;
static struct resource *platform_get_resource(struct platform_device *p,int t,int n){assert(p==&pdev&&!t&&!n);return resource_present?&resource:NULL;}
#define resource_size(r) ((r)->end-(r)->start+1)
static void *of_find_property(struct device_node *n,const char *s,void *len){assert(n==&node&&s&&!len);return property_present?&node:NULL;}
static void *platform_get_drvdata(struct platform_device *p){assert(p==&pdev);return &dsi;}
static void mtk_dsi_mask(struct mtk_dsi *d,u32 o,u32 m,u32 v){assert(d==&dsi);writel((readl(d->regs+o)&~m)|(v&m),d->regs+o);}
static void mtk_dsi_set_interrupt_enable(struct mtk_dsi *);
static void mtk_dsi_irq_data_set(struct mtk_dsi *,u32);
static void mtk_dsi_irq_data_clear(struct mtk_dsi *,u32);
static int mtk_dsi_poweron(struct mtk_dsi *);
static void mtk_output_dsi_enable(struct mtk_dsi *);
static int mtk_dsi_bind(struct device *,struct device *,void *);
static void mtk_dsi_unbind(struct device *,struct device *,void *);
static void mtk_dsi_set_interrupt_enable_legacy(struct mtk_dsi *d){assert(d==&dsi);configured++;}
static void mtk_dsi_irq_data_set_legacy(struct mtk_dsi *d,u32 b){d->irq_data|=b;}
static void mtk_dsi_irq_data_clear_legacy(struct mtk_dsi *d,u32 b){d->irq_data&=~b;}
static irqreturn_t mtk_dsi_irq_legacy(int i,void *d){(void)i;(void)d;return 7;}
static s32 mtk_dsi_switch_to_cmd_mode_legacy(struct mtk_dsi *d,u8 f,u32 t){(void)d;(void)f;(void)t;return 7;}
static void mtk_dsi_poweroff_legacy(struct mtk_dsi *d){assert(d==&dsi);d->refcount--;}
static void mtk_output_dsi_enable_legacy(struct mtk_dsi *d){assert(d==&dsi);d->enabled=true;configured++;}
static ssize_t mtk_dsi_host_transfer_legacy(struct mipi_dsi_host *h,const struct mipi_dsi_msg *m){(void)h;(void)m;return 7;}
static int mtk_dsi_probe_legacy(struct platform_device *p){(void)p;return 7;}
static void mtk_dsi_remove_legacy(struct platform_device *p){(void)p;}
static const struct component_ops mtk_dsi_component_ops={mtk_dsi_bind,mtk_dsi_unbind};
enum drm_mode_status {MODE_OK,MODE_ERROR,MODE_CLOCK_LOW,MODE_CLOCK_HIGH};
struct drm_display_info {int unused;};struct drm_display_mode {int clock;};
static enum drm_mode_status mtk_dsi_bridge_mode_valid_legacy(struct drm_bridge *b,const struct drm_display_info *i,const struct drm_display_mode *m){(void)b;(void)i;(void)m;return MODE_OK;}
static void mtk_dsi_bridge_mode_set_legacy(struct drm_bridge *b,const struct drm_display_mode *m,const struct drm_display_mode *a){(void)b;(void)m;(void)a;}
#define drm_display_mode_to_videomode(m,v) ((v)->pixelclock=(uint64_t)(m)->clock*1000)

static void mtk_output_dsi_disable(struct mtk_dsi *d){d->enabled=false;}
