 mtk_output_dsi_enable(&dsi);assert(dsi.enabled);mtk_dsi_poweroff(&dsi);assert(dsi.refcount==1);mtk_dsi_poweroff(&dsi);assert(!dsi.refcount&&!dsi.strict_phy_owned&&irq_disabled==1);
