      "$schema": "http://devicetree.org/meta-schemas/core.yaml#",
      "allOf": [
        {
          "$ref": "regulator.yaml#"
        },
        {
          "if": {
            "properties": {
              "compatible": {
                "contains": {
                  "const": "silergy,sym827"
                }
              }
            },
            "required": [
              "compatible"
            ]
          },
          "then": {
            "properties": {
              "vsel-gpios": false
            },
            "required": [
              "fcs,suspend-voltage-selector"
            ]
          }
        }
      ],
      "patternProperties": {
        "^pinctrl-[0-9]+$": true
      },
      "properties": {
        "$nodename": true,
        "bootph-all": true,
        "bootph-pre-ram": true,
        "bootph-pre-sram": true,
        "bootph-some-ram": true,
        "bootph-verify": true,
        "compatible": {
          "oneOf": [
            {
              "items": [
                {
                  "enum": [
                    "fcs,fan53555",
                    "fcs,fan53526",
                    "rockchip,rk8600",
                    "rockchip,rk8602",
                    "silergy,sym827",
                    "silergy,syr827",
                    "silergy,syr828",
                    "tcs,tcs4525"
                  ]
                }
              ],
              "maxItems": 1,
              "minItems": 1,
              "type": "array"
            },
            {
              "items": [
                {
                  "const": "rockchip,rk8601"
                },
                {
                  "const": "rockchip,rk8600"
                }
              ],
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "items": [
                {
                  "const": "rockchip,rk8603"
                },
                {
                  "const": "rockchip,rk8602"
                }
              ],
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          ]
        },
        "fcs,suspend-voltage-selector": {
          "$ref": "/schemas/types.yaml#/definitions/uint32",
          "enum": [
            0,
            1
          ]
        },
        "phandle": true,
        "pinctrl-names": true,
        "reg": {
          "maxItems": 1,
          "minItems": 1
        },
        "secure-status": true,
        "status": true,
        "vin-supply": {},
        "vsel-gpios": {
          "maxItems": 1,
          "minItems": 1
        }
      },
      "required": [
        "compatible",
        "reg"
      ],
      "title": "Fairchild FAN53555 regulators",
      "type": "object",
      "unevaluatedProperties": false
    },
