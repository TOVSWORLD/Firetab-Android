{
  "root": "http://devicetree.org/schemas/iommu/mediatek,iommu.yaml",
  "schemas": {
    "http://devicetree.org/schemas/iommu/mediatek,iommu.yaml": {
      "$id": "http://devicetree.org/schemas/iommu/mediatek,iommu.yaml#",
      "$schema": "http://devicetree.org/meta-schemas/core.yaml#",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "compatible": {
                "contains": {
                  "enum": [
                    "mediatek,mt2701-m4u",
                    "mediatek,mt2712-m4u",
                    "mediatek,mt6795-m4u",
                    "mediatek,mt6893-iommu-mm",
                    "mediatek,mt8173-m4u",
                    "mediatek,mt8186-iommu-mm",
                    "mediatek,mt8188-iommu-vdo",
                    "mediatek,mt8188-iommu-vpp",
                    "mediatek,mt8192-m4u",
                    "mediatek,mt8195-iommu-vdo",
                    "mediatek,mt8195-iommu-vpp"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "clocks"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "compatible": {
                "items": [
                  {
                    "enum": [
                      "mediatek,mt6893-iommu-mm",
                      "mediatek,mt8186-iommu-mm",
                      "mediatek,mt8188-iommu-vdo",
                      "mediatek,mt8188-iommu-vpp",
                      "mediatek,mt8192-m4u",
                      "mediatek,mt8195-iommu-vdo",
                      "mediatek,mt8195-iommu-vpp"
                    ]
                  }
                ],
                "maxItems": 1,
                "minItems": 1,
                "type": "array"
              }
            }
          },
          "then": {
            "required": [
              "power-domains"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "compatible": {
                "contains": {
                  "enum": [
                    "mediatek,mt2712-m4u",
                    "mediatek,mt6795-m4u",
                    "mediatek,mt8173-m4u"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "mediatek,infracfg"
            ]
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "compatible": {
                  "contains": {
                    "enum": [
                      "mediatek,mt8188-iommu-infra",
                      "mediatek,mt8195-iommu-infra"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "mediatek,larbs"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "required": [
            "interrupts"
          ]
        },
        {
          "required": [
            "interrupts-extended"
          ]
        }
      ],
      "patternProperties": {
        "^pinctrl-[0-9]+$": true
      },
      "properties": {
        "#iommu-cells": {
          "const": 1
        },
        "$nodename": true,
        "assigned-clock-parents": true,
        "assigned-clock-rates": true,
        "assigned-clock-rates-u64": true,
        "assigned-clock-sscs": true,
        "assigned-clocks": true,
        "bootph-all": true,
        "bootph-pre-ram": true,
        "bootph-pre-sram": true,
        "bootph-some-ram": true,
        "bootph-verify": true,
        "clock-names": {
          "items": [
            {
              "const": "bclk"
            }
          ],
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "clocks": {
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "compatible": {
          "oneOf": [
            {
              "items": [
                {
                  "enum": [
                    "mediatek,mt2701-m4u",
                    "mediatek,mt2712-m4u",
                    "mediatek,mt6779-m4u",
                    "mediatek,mt6795-m4u",
                    "mediatek,mt6893-iommu-mm",
                    "mediatek,mt8163-m4u",
                    "mediatek,mt8167-m4u",
                    "mediatek,mt8173-m4u",
                    "mediatek,mt8183-m4u",
                    "mediatek,mt8186-iommu-mm",
                    "mediatek,mt8188-iommu-vdo",
                    "mediatek,mt8188-iommu-vpp",
                    "mediatek,mt8188-iommu-infra",
                    "mediatek,mt8192-m4u",
                    "mediatek,mt8195-iommu-vdo",
                    "mediatek,mt8195-iommu-vpp",
                    "mediatek,mt8195-iommu-infra",
                    "mediatek,mt8365-m4u"
                  ]
                }
              ],
              "maxItems": 1,
              "minItems": 1,
              "type": "array"
            },
            {
              "items": [
                {
                  "const": "mediatek,mt7623-m4u"
                },
                {
                  "const": "mediatek,mt2701-m4u"
                }
              ],
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          ]
        },
        "interrupt-parent": true,
        "interrupts": {
          "maxItems": 1,
          "minItems": 1
        },
        "interrupts-extended": {
          "maxItems": 1,
          "minItems": 1
        },
        "mediatek,infracfg": {
          "$ref": "/schemas/types.yaml#/definitions/phandle"
        },
        "mediatek,larbs": {
          "$ref": "/schemas/types.yaml#/definitions/phandle-array",
          "items": {
            "maxItems": 1,
            "minItems": 1
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "phandle": true,
        "pinctrl-names": true,
        "power-domains": {
          "maxItems": 1,
          "minItems": 1
        },
        "reg": {
          "maxItems": 1,
          "minItems": 1
        },
        "secure-status": true,
        "status": true
      },
      "required": [
        "compatible",
        "reg",
        "#iommu-cells"
      ],
      "title": "MediaTek IOMMU Architecture Implementation",
      "type": "object"
    },
    "http://devicetree.org/schemas/types.yaml": {
      "$id": "http://devicetree.org/schemas/types.yaml#",
      "$schema": "http://devicetree.org/meta-schemas/base.yaml#",
      "definitions": {
        "address": {
          "$ref": "#/definitions/uint32-matrix",
          "items": {
            "maxItems": 5,
            "minItems": 1
          },
          "type": "array"
        },
        "flag": {
          "oneOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "int16": {
          "maximum": 8191,
          "minimum": -8192,
          "type": "integer",
          "typeSize": 16
        },
        "int16-array": {
          "items": {
            "$ref": "#/definitions/int16"
          },
          "minItems": 1,
          "type": "array"
        },
        "int16-matrix": {
          "items": {
            "$ref": "#/definitions/int16-array"
          },
          "minItems": 1,
          "type": "array"
        },
        "int32": {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        "int32-array": {
          "items": {
            "$ref": "#/definitions/int32"
          },
          "minItems": 1,
          "type": "array"
        },
        "int32-matrix": {
          "items": {
            "$ref": "#/definitions/int32-array"
          },
          "minItems": 1,
          "type": "array"
        },
        "int64": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer",
          "typeSize": 64
        },
        "int64-array": {
          "items": {
            "$ref": "#/definitions/int64"
          },
          "minItems": 1,
          "type": "array"
        },
        "int64-matrix": {
          "items": {
            "$ref": "#/definitions/int64-array"
          },
          "minItems": 1,
          "type": "array"
        },
        "int8": {
          "maximum": 127,
          "minimum": -128,
          "type": "integer",
          "typeSize": 8
        },
        "int8-array": {
          "items": {
            "$ref": "#/definitions/int8"
          },
          "minItems": 1,
          "type": "array"
        },
        "int8-matrix": {
          "items": {
            "$ref": "#/definitions/int8-array"
          },
          "minItems": 1,
          "type": "array"
        },
        "non-unique-string-array": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "phandle": {
          "$ref": "#/definitions/phandle-array",
          "items": {
            "maxItems": 1,
            "minItems": 1
          },
          "maxItems": 1,
          "type": "array"
        },
        "phandle-array": {
          "items": {
            "additionalItems": {
              "$ref": "#/definitions/uint32"
            },
            "items": [
              {
                "oneOf": [
                  {
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "const": 0,
                    "type": "integer"
                  }
                ]
              }
            ],
            "maxItems": 1024,
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "type": "array"
        },
        "string": {
          "allOf": [
            {
              "$ref": "#/definitions/string-array"
            },
            {
              "maxItems": 1,
              "minItems": 1
            }
          ]
        },
        "string-array": {
          "allOf": [
            {
              "$ref": "#/definitions/non-unique-string-array"
            },
            {
              "uniqueItems": true
            }
          ]
        },
        "uint16": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer",
          "typeSize": 16
        },
        "uint16-array": {
          "items": {
            "$ref": "#/definitions/uint16"
          },
          "minItems": 1,
          "type": "array"
        },
        "uint16-matrix": {
          "items": {
            "$ref": "#/definitions/uint16-array"
          },
          "minItems": 1,
          "type": "array"
        },
        "uint32": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer",
          "typeSize": 32
        },
        "uint32-array": {
          "items": {
            "$ref": "#/definitions/uint32"
          },
          "minItems": 1,
          "type": "array"
        },
        "uint32-matrix": {
          "items": {
            "$ref": "#/definitions/uint32-array"
          },
          "minItems": 1,
          "type": "array"
        },
        "uint64": {
          "maximum": 18446744073709551615,
          "minimum": 0,
