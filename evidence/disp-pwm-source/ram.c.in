static u64 round_div(u64 n,u64 d){if(!d){divide_zero++;return 0;}return n/d+(n%d!=0);}
#define DIV64_U64_ROUND_UP(n,d) round_div((n),(d))
static u64 mul_u64_u64_div_u64(u64 a,u64 b,u64 d){assert(d);return (u64)((__uint128_t)a*b/d);}
static unsigned slot(void *p){uintptr_t o=(uintptr_t)p-(uintptr_t)regs;assert(o<sizeof(regs)&&!(o&3));if(o>maxoff)maxoff=o;return o/4;}
static u32 readl(void *p){return regs[slot(p)];}static void writel(u32 v,void *p){unsigned o=slot(p);regs[o]=v;writes++;if(o==2)commit_writes++;}
static void *pwmchip_get_drvdata(struct pwm_chip *c){assert(c==&chip);return &mdp;}static struct device *pwmchip_parent(struct pwm_chip *c){assert(c==&chip);return &pdev.dev;}
static int clk_prepare_enable(struct clk *c){assert(c==&main_clk||c==&mm_clk);if(c==&main_clk){main_on++;return fail_main?-EIO:0;}mm_on++;return fail_mm?-EBUSY:0;}
static void clk_disable_unprepare(struct clk *c){if(c==&main_clk)main_off++;else {assert(c==&mm_clk);mm_off++;}}
static u64 clk_get_rate(struct clk *c){assert(c==&main_clk);return rate;}
static int step(void){return ++probe_step==fail_probe;}
static struct pwm_chip *devm_pwmchip_alloc(struct device *d,unsigned n,size_t size){assert(d==&pdev.dev&&n==1&&size==sizeof(mdp));return step()?ERR_PTR(-ENOMEM):&chip;}
static const void *match;static const void *of_device_get_match_data(struct device *d){assert(d==&pdev.dev);return match;}
static void *devm_platform_ioremap_resource(struct platform_device *p,unsigned i){assert(p==&pdev&&!i);return step()?ERR_PTR(-EIO):regs;}
static struct clk *devm_clk_get(struct device *d,const char *n){assert(d==&pdev.dev);return step()?ERR_PTR(-EPROBE_DEFER):!strcmp(n,"main")?&main_clk:&mm_clk;}
static int devm_pwmchip_add(struct device *d,struct pwm_chip *c){assert(d==&pdev.dev&&c==&chip);return step()?-EIO:0;}
