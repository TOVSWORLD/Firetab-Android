+/* MT8163 vendor USB20 port0: measure first, then apply the full-byte policy. */
+static void mt8163_hs_slew_measure_and_apply(struct mtk_tphy *tphy,
+	struct mtk_phy_instance *instance)
+{
+	void __iomem *fmreg = instance->u2_banks.fmreg;
+	void __iomem *com = instance->u2_banks.com;
+	u32 fm_out = 0;
+	u32 control;
+	u8 status;
+	int ret;
+
+	mutex_lock(&tphy->u2_freq_lock);
+	writeb(0x80, com + 0x15);
+	udelay(1);
+	control = readl(fmreg + U3P_U2FREQ_FMMONR1) | P2F_RG_FRCK_EN;
+	writel(control, fmreg + U3P_U2FREQ_FMMONR1);
+	control = readl(fmreg + U3P_U2FREQ_FMCR0);
+	control &= ~(P2F_RG_CYCLECNT | P2F_RG_MONCLK_SEL);
+	control |= FIELD_PREP(P2F_RG_CYCLECNT, U3P_FM_DET_CYCLE_CNT);
+	writel(control, fmreg + U3P_U2FREQ_FMCR0);
+	writel(control | P2F_RG_FREQDET_EN, fmreg + U3P_U2FREQ_FMCR0);
+
+	ret = readb_poll_timeout(fmreg + U3P_U2FREQ_FMMONR1, status,
+				status & P2F_USB_FM_VALID, 10, 3000000);
+	if (!ret)
+		fm_out = readl(fmreg + U3P_U2FREQ_VALUE);
+
+	/* All measurement outcomes clean up; no unused formula or zero divide. */
+	control = readl(fmreg + U3P_U2FREQ_FMCR0) & ~P2F_RG_FREQDET_EN;
+	writel(control, fmreg + U3P_U2FREQ_FMCR0);
+	control = readl(fmreg + U3P_U2FREQ_FMMONR1) & ~P2F_RG_FRCK_EN;
+	writel(control, fmreg + U3P_U2FREQ_FMMONR1);
+	writeb(0x60, com + 0x15);
+	writeb(readb(com + 0x15) & ~0x80, com + 0x15);
+	mutex_unlock(&tphy->u2_freq_lock);
+
+	if (ret || !fm_out)
+		dev_warn_ratelimited(tphy->dev,
+			"MT8163 USB2 calibration observation: timeout=%d fm_out=%u; vendor byte applied\n",
+			ret, fm_out);
+}
