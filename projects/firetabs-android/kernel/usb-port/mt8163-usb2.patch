+static int mt8163_usb2_validate_eye(struct device_node *np)
+{
+	const char * const names[] = { "mediatek,eye-vrt", "mediatek,eye-term" };
+	u32 value;
+	unsigned int i;
+
+	if (of_property_read_bool(np, "mediatek,eye-src"))
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		if (of_property_read_bool(np, names[i]) &&
+		    (of_property_read_u32(np, names[i], &value) || value != 7))
+			return -EINVAL;
+	}
+	return 0;
+}
