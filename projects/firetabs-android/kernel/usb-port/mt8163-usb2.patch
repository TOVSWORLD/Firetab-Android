+/* Match the retained vendor analog operations, without forcing USB role bits. */
+static void mt8163_usb2_apply_analog(struct mtk_phy_instance *instance,
+				   bool recovery)
+{
+	void __iomem *com = instance->u2_banks.com;
+	u8 rx = readb(com + U3P_USBPHYACR6);
+
+	/* Cold init preserves bit3; recovery explicitly clears it. Both preserve bit0. */
+	if (recovery)
+		rx &= ~BIT(3);
+	writeb(rx | GENMASK(2, 1), com + U3P_USBPHYACR6);
+	mtk_phy_set_bits(com + U3P_USBPHYACR1, PA1_RG_VRT_SEL | PA1_RG_TERM_SEL);
+}
