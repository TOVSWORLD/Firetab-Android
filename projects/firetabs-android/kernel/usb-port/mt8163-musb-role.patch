+/* Strict MT8163 transactions: API cleanup is best-effort, never hardware proof. */
+static void mt8163_role_fault(struct mtk_glue *glue, const char *stage, int ret)
+{
+	glue->role_faulted = true;
+	dev_err(glue->dev, "MT8163 %s failed: %d; role unqualified for this instance\n",
+		stage, ret);
+}
+
+static int mt8163_musb_phy_cleanup(struct mtk_glue *glue)
+{
+	int ret;
+
+	glue->role_ready = false;
+	if (glue->phy_powered) {
+		ret = phy_power_off(glue->phy);
+		if (ret) {
+			mt8163_role_fault(glue, "power-off cleanup", ret);
+			return ret;
+		}
+		glue->phy_powered = false;
+	}
+	if (glue->phy_initialized) {
+		ret = phy_exit(glue->phy);
+		if (ret) {
+			mt8163_role_fault(glue, "exit cleanup", ret);
+			return ret;
+		}
+		glue->phy_initialized = false;
+	}
+	return 0;
+}
+
+static int mt8163_musb_phy_init(struct mtk_glue *glue)
+{
+	int ret;
+
+	if (glue->role_faulted || glue->phy_initialized)
+		return -EIO;
+	ret = phy_init(glue->phy);
+	if (ret)
+		goto fault;
+	glue->phy_initialized = true;
+	ret = phy_power_on(glue->phy);
+	if (ret)
+		goto cleanup;
+	glue->phy_powered = true;
+	ret = phy_set_mode(glue->phy, glue->phy_mode);
+	if (ret)
+		goto cleanup;
+	glue->role_ready = true;
+	return 0;
+
+cleanup:
+	mt8163_musb_phy_cleanup(glue);
+fault:
+	mt8163_role_fault(glue, "PHY initialization", ret);
+	return ret;
+}
+
+static int mt8163_otg_switch_set(struct mtk_glue *glue, enum usb_role role)
+{
+	struct musb *musb = glue->musb;
+	enum phy_mode mode;
+	bool want_power, added_power = false;
+	int ret, cleanup;
+	u8 devctl;
+
+	switch (role) {
+	case USB_ROLE_HOST:
+		mode = PHY_MODE_USB_HOST;
+		break;
+	case USB_ROLE_DEVICE:
+		mode = PHY_MODE_USB_DEVICE;
+		break;
+	case USB_ROLE_NONE:
+		mode = PHY_MODE_USB_OTG;
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (glue->role_faulted)
+		return -EIO;
+	if (!glue->role_ready)
+		return -EAGAIN;
+	want_power = role != USB_ROLE_NONE;
+	if (role == glue->role && glue->phy_powered == want_power)
+		return 0;
+
+	if (want_power && !glue->phy_powered) {
+		ret = phy_power_on(glue->phy);
+		if (ret)
+			goto fault;
+		added_power = true;
+		glue->phy_powered = true;
+	}
+	ret = phy_set_mode(glue->phy, mode);
+	if (ret)
+		goto restore;
+	if (!want_power && glue->phy_powered) {
+		ret = phy_power_off(glue->phy);
+		if (ret)
+			goto restore;
+		glue->phy_powered = false;
+	}
+
+	/* Publish controller/software state only after the backend calls succeed. */
+	devctl = readb(musb->mregs + MUSB_DEVCTL);
+	if (role == USB_ROLE_HOST) {
+		devctl |= MUSB_DEVCTL_SESSION;
+		musb->xceiv->otg->state = OTG_STATE_A_WAIT_VRISE;
+		MUSB_HST_MODE(musb);
+	} else {
+		devctl &= ~MUSB_DEVCTL_SESSION;
+		if (role == USB_ROLE_DEVICE) {
+			musb->xceiv->otg->state = OTG_STATE_B_IDLE;
+			MUSB_DEV_MODE(musb);
+		}
+	}
+	musb_writeb(musb->mregs, MUSB_DEVCTL, devctl);
+	glue->phy_mode = mode;
+	glue->role = role;
+	return 0;
+
+restore:
+	cleanup = phy_set_mode(glue->phy, glue->phy_mode);
+	if (cleanup)
+		mt8163_role_fault(glue, "mode restoration", cleanup);
+	if (added_power) {
+		cleanup = phy_power_off(glue->phy);
+		if (cleanup)
+			mt8163_role_fault(glue, "power restoration", cleanup);
+		else
+			glue->phy_powered = false;
+	}
+fault:
+	mt8163_role_fault(glue, "role transaction", ret);
+	return ret;
+}
