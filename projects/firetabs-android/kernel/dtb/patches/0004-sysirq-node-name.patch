From: FireTabs contributors
Subject: [PATCH] arm64: dts: mt8163: use interrupt-controller node name

Preserve label, phandle and all interrupt/register properties.

--- a/arch/arm64/boot/dts/mediatek/mt8163.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt8163.dtsi
@@ -421,7 +421,7 @@
 			status = "disabled";
 		};
 
-		sysirq: intpol-controller@10200620 {
+		sysirq: interrupt-controller@10200620 {
 			compatible = "mediatek,mt8163-sysirq", "mediatek,mt6577-sysirq";
 			reg = <0 0x10200620 0 0x20>;
 			#interrupt-cells = <3>;
