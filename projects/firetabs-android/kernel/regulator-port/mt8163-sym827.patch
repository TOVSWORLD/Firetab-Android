+/* SYM827 ID/revision from the pinned MT8163 donor, not a SYR alias. */
+static int fan53555_sym827_validate(struct device_node *np,
+                                  unsigned int id, unsigned int rev,
+                                  unsigned int sleep_vsel_id)
+{
+	u32 selector;
+
+	if ((id & 0xe0) != 0x80 || (id & DIE_ID) != 1 ||
+	    (rev & DIE_REV) != 12)
+		return -ENODEV;
+	/* No implicit bank choice or legacy external GPIO/DVS ownership. */
+	if (!np || of_property_count_u32_elems(np,
+			"fcs,suspend-voltage-selector") != 1 ||
+	    of_property_read_u32(np, "fcs,suspend-voltage-selector", &selector) ||
+	    selector > 1 || selector != sleep_vsel_id ||
+	    of_find_property(np, "vsel-gpio", NULL) ||
+	    of_find_property(np, "vsel-gpios", NULL) ||
+	    of_find_property(np, "en-gpio", NULL))
+		return -EINVAL;
+	return 0;
+}
+
+static int fan53555_voltages_setup_sym827(struct fan53555_device_info *di)
+{
+	if (di->chip_id != 1 || di->chip_rev != 12)
+		return -ENODEV;
+	di->vsel_min = 600000;
+	di->vsel_step = 12500;
+	di->vsel_count = FAN53555_NVOLTAGES;
+	di->slew_reg = FAN53555_CONTROL;
+	di->slew_mask = CTL_SLEW_MASK;
+	di->ramp_delay_table = slew_rates;
+	di->n_ramp_values = ARRAY_SIZE(slew_rates);
+	di->enable_time = 400;
+	return 0;
+}
