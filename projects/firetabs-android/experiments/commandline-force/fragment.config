# Opt-in compile experiment; never used by the default kernel workflow.
# Requires a valid chosen node and firmware-initialized UART0. Not hardware-qualified.
CONFIG_CMDLINE="nr_cpus=1 maxcpus=0 earlycon=uart8250,mmio32,0x11002000 console=ttyS0,921600n8"
CONFIG_CMDLINE_FORCE=y
# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
# CONFIG_CMDLINE_EXTEND is not set
